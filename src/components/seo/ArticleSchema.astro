---
export interface Props {
  headline: string;
  description: string;
  image: string;
  datePublished: Date;
  dateModified?: Date;
  author: string;
  url: string;
  keywords?: string[];
  category?: string;
}

const {
  headline,
  description,
  image,
  datePublished,
  dateModified,
  author,
  url,
  keywords,
  category,
} = Astro.props;

const siteUrl = 'https://www.metalurgicabotomariani.com.ar';
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const canonicalUrl = url.startsWith('http') ? url : `${siteUrl}${url}`;

const schema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": headline,
  "description": description,
  "image": imageUrl,
  "datePublished": datePublished.toISOString(),
  "dateModified": (dateModified || datePublished).toISOString(),
  "author": {
    "@type": "Organization",
    "name": author,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "Metalurgica Boto Mariani SRL",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/logos/logo.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};

if (keywords && keywords.length > 0) schema["keywords"] = keywords.join(', ');
if (category) schema["articleSection"] = category;
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
