---
import BaseLayout from '../layouts/BaseLayout.astro';

// Datos del documento: actualizar en cada revisión de la política
const documento = {
  version: '1',
  lugar: 'Buenos Aires',
  fecha: '11 de noviembre de 2026',
  firma: 'Facundo Boto Mariani',
  cargo: 'Gerente General',
};

const compromisos = [
  {
    titulo: 'Cumplir los requisitos',
    texto: 'de nuestros clientes, las especificaciones de cada proyecto, las normas técnicas aplicables y los requisitos legales y reglamentarios.',
  },
  {
    titulo: 'Asegurar la calidad en cada etapa,',
    texto: 'del cálculo al montaje, con controles definidos y con trazabilidad de materiales cuando el producto o el cliente lo requieren.',
  },
  {
    titulo: 'Validar nuestros productos y nuestra gente con terceros independientes:',
    texto: 'mantener la certificación INTI IP66 de nuestros gabinetes y calificar a nuestros soldadores mediante el convenio con la Universidad Nacional de Lomas de Zamora.',
  },
  {
    titulo: 'Mejorar de forma continua',
    texto: 'la eficacia de nuestro sistema de gestión de la calidad, a partir de la medición de los procesos, los reclamos de los clientes y las lecciones de cada proyecto.',
  },
  {
    titulo: 'Formar a nuestro personal y promover una cultura de la calidad,',
    texto: 'en la que cada persona entienda cómo su trabajo afecta el producto final y actúe con ética.',
  },
  {
    titulo: 'Fijar objetivos de calidad medibles,',
    texto: 'coherentes con esta política, y revisarlos periódicamente.',
  },
];

const practica = [
  {
    titulo: 'Diseño y cálculo',
    texto: 'Cada estructura se calcula y se proyecta antes de fabricarse, según los reglamentos CIRSOC y las especificaciones del proyecto.',
  },
  {
    titulo: 'Soldadura',
    texto: 'Nuestros soldadores se califican con la Universidad Nacional de Lomas de Zamora, un tercero independiente que evalúa su trabajo.',
  },
  {
    titulo: 'Productos certificados',
    texto: 'Nuestros gabinetes eléctricos cuentan con certificación INTI de grado de protección IP66.',
  },
  {
    titulo: 'Trazabilidad',
    texto: 'En gabinetes y en los trabajos que lo requieren, registramos el origen de los materiales y los vinculamos con el producto terminado.',
  },
  {
    titulo: 'Montaje',
    texto: 'El montaje lo ejecuta o lo controla nuestro propio equipo, con un control de obra estricto, para que lo que se calculó sea lo que se construye.',
  },
];
---

<BaseLayout
  title="Política de Calidad"
  description="Política de Calidad de Metalúrgica Boto Mariani: compromisos de la Dirección para el diseño, cálculo, proyecto, fabricación y montaje de estructuras metálicas, según la norma ISO 9001."
>
  <!-- Hero -->
  <section class="relative bg-primary text-white py-20">
    <div class="container">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
          POLÍTICA DE<br />
          <span class="text-accent">CALIDAD</span>
        </h1>
        <p class="text-xl text-gray-200">
          En una estructura metálica, la calidad no se ve en la foto final. Está en un cálculo bien hecho, en una soldadura ejecutada por alguien calificado y en un montaje que respeta lo proyectado.
        </p>
      </div>
    </div>
  </section>

  <!-- Introducción -->
  <section class="section">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="text-lg text-gray-600">
          Con más de 30 años fabricando estructuras, aprendimos que la confianza de un cliente se gana en esos detalles. Por eso ordenamos nuestra forma de trabajar bajo un sistema de gestión de la calidad basado en la norma ISO 9001.
        </p>
      </div>
    </div>
  </section>

  <!-- La política -->
  <section class="section bg-gray-50">
    <div class="container">
      <article class="max-w-3xl mx-auto bg-white rounded-xl shadow-sm p-8 md:p-12">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">Política de Calidad</h2>
        <p class="text-gray-700 mb-6">
          Metalúrgica Boto Mariani diseña, calcula, proyecta, fabrica y monta estructuras metálicas: desde naves industriales hasta aberturas especiales, incluida infraestructura compleja como shelters y gabinetes eléctricos para equipamiento crítico. Nuestros clientes nos confían obras e instalaciones que tienen que funcionar sin margen de error, en sitios donde corregir después cuesta caro. Por eso la Dirección asume estos compromisos:
        </p>
        <ol class="space-y-4 mb-8">
          {compromisos.map((c, i) => (
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-primary text-white font-bold flex items-center justify-center text-sm">{i + 1}</span>
              <p class="text-gray-700 pt-1"><strong class="text-gray-900">{c.titulo}</strong> {c.texto}</p>
            </li>
          ))}
        </ol>
        <p class="text-gray-700 mb-10">
          Esta política se comunica a todo el personal, está disponible para las partes interesadas y se revisa anualmente.
        </p>
        <div class="border-t border-gray-200 pt-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div>
            <p class="text-gray-500 text-sm">{documento.lugar}, {documento.fecha}.</p>
            <p class="text-gray-900 font-bold mt-2">{documento.firma}</p>
            <p class="text-gray-600 text-sm">{documento.cargo}</p>
          </div>
          <p class="text-sm text-gray-400">Versión {documento.version}</p>
        </div>
      </article>
    </div>
  </section>

  <!-- Cómo la llevamos a la práctica -->
  <section class="section">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="section-title">Cómo la llevamos a la práctica</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {practica.map((p) => (
          <div class="bg-gray-50 p-6 rounded-lg">
            <h3 class="text-lg font-bold text-gray-900 mb-2">{p.titulo}</h3>
            <p class="text-gray-600">{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-primary text-white">
    <div class="container text-center">
      <h2 class="text-3xl font-bold mb-4">¿Tenés un proyecto?</h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        Contanos qué necesitás y lo analizamos con el mismo criterio con el que trabajamos cada estructura.
      </p>
      <a href="/contacto/" class="btn btn-accent">
        Contactar
      </a>
    </div>
  </section>
</BaseLayout>
